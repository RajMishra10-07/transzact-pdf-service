# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Authentication
# In development, DEV_AUTH_BYPASS can be true to allow requests without API key.
# In production, DEV_AUTH_BYPASS MUST be false.
DEV_AUTH_BYPASS=false
API_KEY=erp-service-secret-key-change-in-production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1200

# Concurrency & Memory Safety
NORMAL_WORKER_CONCURRENCY=3
LARGE_WORKER_CONCURRENCY=1
ARCHIVE_WORKER_CONCURRENCY=2
LARGE_DOCUMENT_THRESHOLD=150
RENDER_TIMEOUT_MS=15000
MAX_BROWSER_LIFETIME_RENDERS=50
MAX_BROWSER_MEMORY_MB=750

# Storage Driver: "local" or "s3"
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/storage

# AWS / S3 Compatible Storage (MinIO or AWS S3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=transzact-pdf-documents
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transzact_pdf
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Bulk Processing & Sync Rendering
SYNC_RENDER_TIMEOUT_MS=4500
MAX_BULK_DOCUMENTS=100
MAX_PAYLOAD_SIZE_MB=10

# In-Memory Fallback: set to "true" for standalone offline development without Postgres/Redis
# In Docker or production with PostgreSQL and Redis running, set to "false"
USE_IN_MEMORY_FALLBACK=true
