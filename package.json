{
  "name": "transzact-pdf-service",
  "version": "1.0.0",
  "description": "Production-Oriented PDF Generation Microservice for ERP Application",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.cpSync('src/templates', 'dist/templates', { recursive: true }); fs.cpSync('src/database/migrations', 'dist/database/migrations', { recursive: true });\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.41.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "puppeteer": "^24.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
